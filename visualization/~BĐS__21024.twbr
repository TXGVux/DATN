            <column caption='Loại vay' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Thế chấp&quot;'>
              <calculation class='tableau' formula='&quot;Thế chấp&quot;' />
            </column>
            <column caption='Thời gian vay' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='1' max='30' min='1' />
            </column>
            <column caption='Số tiền vay' datatype='real' default-format='n#,##0;-#,##0' name='[Parameter 6]' param-domain-type='range' role='measure' type='quantitative' value='1000000000.'>
