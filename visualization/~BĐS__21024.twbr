              </calculation>
            </column>
            <column caption='Ngày trả nợ' datatype='datetime' name='[Calculation_1025976329535078413]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, [Calculation_1025976329534160908], [Calculation_1025976329522941952])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Gốc trả hàng tháng' datatype='real' name='[Calculation_1025976329535205390]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6] / [Calculation_1025976329524404226]' />
            </column>
            <column caption='Gốc còn lại' datatype='real' name='[Calculation_1025976329535328271]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6] - [Calculation_1025976329535205390] * [Calculation_1025976329534160908]'>
