    <worksheet name='tổng gl'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold'>Tổng gốc lãi phải trả</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleandatanew3 (CleanNew1)' name='federated.15zsgf21tjc6lh1bqrv3g0mfacnz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Ngân hàng' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;MBBank&quot;'>
              <calculation class='tableau' formula='&quot;MBBank&quot;' />
            </column>
            <column caption='Loại vay' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Thế chấp&quot;'>
              <calculation class='tableau' formula='&quot;Thế chấp&quot;' />
            </column>
            <column caption='Thời gian vay' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='1' max='30' min='1' />
            </column>
            <column caption='Số tiền vay' datatype='real' default-format='n#,##0;-#,##0' name='[Parameter 6]' param-domain-type='range' role='measure' type='quantitative' value='1000000000.'>
              <calculation class='tableau' formula='1000000000.' />
              <range max='20000000000.0' min='1.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15zsgf21tjc6lh1bqrv3g0mfacnz'>
            <column caption='Lãi suất' datatype='real' name='[Calculation_1025976329524133889]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Thế chấp&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &quot;Techcombank&quot; THEN 9.5&#13;&#10;        WHEN &quot;Bản Việt&quot; THEN 14.5&#13;&#10;        WHEN &quot;Vietcombank&quot; THEN 9.5&#13;&#10;        WHEN &quot;Vietinbank&quot; THEN 9.5&#13;&#10;        WHEN &quot;BIDV&quot; THEN 9.5&#13;&#10;        WHEN &quot;Agribank&quot; THEN 10&#13;&#10;        WHEN &quot;ACB&quot; THEN 11.5&#13;&#10;        WHEN &quot;HDBank&quot; THEN 10.5&#13;&#10;        WHEN &quot;VIB&quot; THEN 11&#13;&#10;        WHEN &quot;TPBank&quot; THEN 12&#13;&#10;        WHEN &quot;Sacombank&quot; THEN 12&#13;&#10;        WHEN &quot;VPBank&quot; THEN 12.3&#13;&#10;        WHEN &quot;SHB&quot; THEN 10&#13;&#10;        WHEN &quot;OCB&quot; THEN 7.5&#13;&#10;        WHEN &quot;MSB&quot; THEN 10.8&#13;&#10;        WHEN &quot;MBBank&quot; THEN 10.8&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &quot;Techcombank&quot; THEN 12.9&#13;&#10;        WHEN &quot;Bản Việt&quot; THEN 20.5&#13;&#10;        WHEN &quot;Vietcombank&quot; THEN 14.4&#13;&#10;        WHEN &quot;Vietinbank&quot; THEN 9.6&#13;&#10;        WHEN &quot;BIDV&quot; THEN 11.9&#13;&#10;        WHEN &quot;Agribank&quot; THEN 15&#13;&#10;        WHEN &quot;ACB&quot; THEN 18&#13;&#10;        WHEN &quot;HDBank&quot; THEN 24&#13;&#10;        WHEN &quot;VIB&quot; THEN 18&#13;&#10;        WHEN &quot;TPBank&quot; THEN 16&#13;&#10;        WHEN &quot;Sacombank&quot; THEN 17&#13;&#10;        WHEN &quot;VPBank&quot; THEN 19&#13;&#10;        WHEN &quot;SHB&quot; THEN 16&#13;&#10;        WHEN &quot;OCB&quot; THEN 21&#13;&#10;        WHEN &quot;MSB&quot; THEN 17&#13;&#10;        WHEN &quot;MBBank&quot; THEN 19&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Số tháng vay' datatype='integer' name='[Calculation_1025976329524404226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] * 12' />
            </column>
            <column aggregation='Sum' caption='Lãi suất tháng' datatype='real' name='[Calculation_1025976329524604931]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_1025976329524133889]/100/12' />
            </column>
            <column caption='Góp hàng tháng' datatype='real' name='[Calculation_1025976329526685701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Parameters].[Parameter 6] / [Calculation_1025976329524404226]) + ([Parameters].[Parameter 6] * [Calculation_1025976329524604931])' />
            </column>
            <column caption='Tổng gốc lãi toàn kỳ' datatype='real' name='[Calculation_1025976329527672839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1025976329526685701] * [Calculation_1025976329524404226]' />
